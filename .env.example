# Base URL of the pro-auth NestJS backend, INCLUDING its /v1 version prefix
# (the backend calls app.enableVersioning({ type: URI, defaultVersion: '1' })
# in its src/main.ts, so every route lives under /v1/*, e.g. /v1/auth/login -
# see its Swagger UI at <backend-url>/docs to confirm). Read ONLY on the
# server (route handlers under src/app/api/**) - never exposed to the
# browser bundle, which is why this is not prefixed with NEXT_PUBLIC_.
BACKEND_API_URL=http://localhost:3000/v1

# Name of the httpOnly cookie holding the backend access token.
AUTH_ACCESS_COOKIE=oc_access

# Name of the httpOnly cookie holding the backend refresh token.
AUTH_REFRESH_COOKIE=oc_refresh

# Set to "true" only when serving over HTTPS in production, so auth cookies
# get the Secure flag. Leave unset/false for local http://localhost dev.
COOKIES_SECURE=false
