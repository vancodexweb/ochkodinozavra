# Base URL of the pro-auth NestJS backend. Read ONLY on the server
# (route handlers under src/app/api/**) - never exposed to the browser bundle,
# which is why this is not prefixed with NEXT_PUBLIC_.
BACKEND_API_URL=http://localhost:3000

# Name of the httpOnly cookie holding the backend access token.
AUTH_ACCESS_COOKIE=oc_access

# Name of the httpOnly cookie holding the backend refresh token.
AUTH_REFRESH_COOKIE=oc_refresh

# Set to "true" only when serving over HTTPS in production, so auth cookies
# get the Secure flag. Leave unset/false for local http://localhost dev.
COOKIES_SECURE=false
